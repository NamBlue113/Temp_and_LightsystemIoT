<mxfile host="app.diagrams.net">
  <diagram id="smartroom-blocks" name="Sơ đồ khối Smartroom">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="SƠ ĐỒ KHỐI HỆ THỐNG SMARTROOM (ESP32)" style="text;html=1;fontStyle=1;fontSize=16;align=center;" vertex="1" parent="1">
          <mxGeometry x="300" y="-20" width="500" height="30" as="geometry"/>
        </mxCell>

        <!-- Cảm biến -->
        <mxCell id="grpIn" value="KHỐI VÀO (cảm biến)" style="text;html=1;fontStyle=1;align=center;fontColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="190" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="dht" value="DHT11&lt;br&gt;Nhiệt độ / độ ẩm&lt;br&gt;&lt;i&gt;GPIO4&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="190" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="ldr" value="Cảm biến ánh sáng&lt;br&gt;&lt;i&gt;GPIO34 (ADC 0–4095)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="135" width="190" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="rtc" value="DS3231 RTC&lt;br&gt;&lt;i&gt;I2C 0x68 (SDA21/SCL22)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="205" width="190" height="55" as="geometry"/>
        </mxCell>

        <!-- ESP32 -->
        <mxCell id="esp" value="ESP32 DevKit – firmware (Arduino / PlatformIO)" style="swimlane;html=1;startSize=26;rounded=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="290" y="30" width="470" height="430" as="geometry"/>
        </mxCell>
        <mxCell id="m1" value="Đọc nhiệt/ẩm, ánh sáng&lt;br&gt;(lọc, giữ 3 s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="esp">
          <mxGeometry x="20" y="45" width="190" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="m2" value="Thời gian&lt;br&gt;NTP (UTC+7) + DS3231" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="esp">
          <mxGeometry x="20" y="140" width="190" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="m3" value="&lt;b&gt;Logic điều khiển&lt;/b&gt;&lt;br&gt;Quạt: trễ 30/28 °C, 80/75 %&lt;br&gt;Đèn: trong khung giờ &lt;b&gt;VÀ&lt;/b&gt; trời tối&lt;br&gt;Chế độ Auto / Manual" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="esp">
          <mxGeometry x="250" y="45" width="200" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="m4" value="Lịch sử&lt;br&gt;288 mẫu / 5 phút (RAM)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="esp">
          <mxGeometry x="20" y="235" width="190" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="m5" value="NVS (Preferences)&lt;br&gt;Lịch, ngưỡng, cấu hình" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="esp">
          <mxGeometry x="250" y="235" width="200" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="m6" value="&lt;b&gt;WebServer + REST API&lt;/b&gt;&lt;br&gt;/api/status · led · fan · schedule · light · history&lt;br&gt;Xác thực X-Auth, khóa 60 s sau 5 lần sai" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="esp">
          <mxGeometry x="20" y="325" width="430" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="m7" value="ArduinoOTA (nạp code qua Wi-Fi) · LED trạng thái" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="esp">
          <mxGeometry x="20" y="390" width="430" height="30" as="geometry"/>
        </mxCell>

        <!-- Khối ra -->
        <mxCell id="grpOut" value="KHỐI RA (chấp hành)" style="text;html=1;fontStyle=1;align=center;fontColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="830" y="30" width="190" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="fan" value="Quạt DC qua MOSFET&lt;br&gt;&lt;i&gt;GPIO23, PWM 1 kHz 8-bit&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="830" y="60" width="190" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="lamp" value="Đèn LED chiếu sáng&lt;br&gt;&lt;i&gt;GPIO19&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="830" y="140" width="190" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="lcd" value="LCD I2C (PCF8574)&lt;br&gt;&lt;i&gt;SDA21 / SCL22&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="830" y="215" width="190" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="sled" value="LED trạng thái&lt;br&gt;&lt;i&gt;GPIO18&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="830" y="410" width="190" height="50" as="geometry"/>
        </mxCell>

        <!-- Nguồn -->
        <mxCell id="pwr" value="Nguồn ngoài / USB 5 V" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="40" y="350" width="190" height="50" as="geometry"/>
        </mxCell>

        <!-- Mạng -->
        <mxCell id="ntp" value="Máy chủ NTP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="540" width="190" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="router" value="Router Wi-Fi (LAN)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="400" y="540" width="190" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="phone" value="Điện thoại / trình duyệt&lt;br&gt;Web UI: dashboard, biểu đồ, điều khiển" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="400" y="650" width="190" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="mqtt" value="MQTT cloud (HiveMQ)&lt;br&gt;&lt;i&gt;dự kiến – điều khiển từ xa&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="830" y="540" width="190" height="60" as="geometry"/>
        </mxCell>

        <!-- Edges: vào -->
        <mxCell id="e1" value="1-wire" style="endArrow=classic;html=1;" edge="1" parent="1" source="dht" target="m1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="analog" style="endArrow=classic;html=1;" edge="1" parent="1" source="ldr" target="m1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="I2C" style="endArrow=classic;startArrow=classic;html=1;" edge="1" parent="1" source="rtc" target="m2"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Nội bộ -->
        <mxCell id="i1" value="số đo" style="endArrow=classic;html=1;" edge="1" parent="1" source="m1" target="m3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i2" value="giờ" style="endArrow=classic;html=1;" edge="1" parent="1" source="m2" target="m3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i3" value="ghi mẫu" style="endArrow=classic;html=1;" edge="1" parent="1" source="m1" target="m4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i4" value="ngưỡng / lịch" style="endArrow=classic;startArrow=classic;html=1;" edge="1" parent="1" source="m5" target="m3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i5" value="đọc" style="endArrow=classic;html=1;" edge="1" parent="1" source="m4" target="m6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i6" value="lưu / tải cấu hình, lệnh" style="endArrow=classic;startArrow=classic;html=1;" edge="1" parent="1" source="m5" target="m6"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Ra -->
        <mxCell id="o1" value="PWM" style="endArrow=classic;html=1;" edge="1" parent="1" source="m3" target="fan"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="o2" value="ON/OFF" style="endArrow=classic;html=1;" edge="1" parent="1" source="m3" target="lamp"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="o3" value="I2C" style="endArrow=classic;html=1;" edge="1" parent="1" source="m3" target="lcd"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="o4" value="mã nháy" style="endArrow=classic;html=1;" edge="1" parent="1" source="m7" target="sled"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Nguồn -->
        <mxCell id="p1" value="cấp nguồn" style="endArrow=classic;html=1;dashed=1;strokeColor=#d79b00;" edge="1" parent="1" source="pwr" target="esp"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Mạng -->
        <mxCell id="n1" value="Wi-Fi (HTTP)" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#9673a6;" edge="1" parent="1" source="esp" target="router"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n2" value="đồng bộ giờ" style="endArrow=classic;html=1;" edge="1" parent="1" source="ntp" target="router"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n3" value="Wi-Fi LAN (JSON + X-Auth)" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#9673a6;" edge="1" parent="1" source="router" target="phone"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n4" value="" style="endArrow=classic;startArrow=classic;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1" source="router" target="mqtt"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n5" value="Internet (dự kiến)" style="endArrow=classic;startArrow=classic;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1" source="phone" target="mqtt"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Chú giải -->
        <mxCell id="legend" value="Xanh dương: khối vào · Xanh lá: khối ra / điều khiển · Vàng: dữ liệu &amp; lưu trữ · Tím: giao tiếp mạng · Đỏ: bảo trì · Nét đứt: chưa triển khai" style="text;html=1;align=left;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="740" width="980" height="30" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
